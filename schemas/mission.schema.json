{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mission.schema.json",
  "title": "Mission",
  "description": "Mission Runner 核心任务定义 Schema - MVP Phase 1",
  "type": "object",
  "required": ["missionId", "title", "goal", "status", "createdAt", "updatedAt"],
  "properties": {
    "missionId": {
      "type": "string",
      "description": "唯一任务标识符，格式：mission-{YYYYMMDD}-{NNN}",
      "pattern": "^mission-[0-9]{8}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "description": "任务标题，简短描述任务目标",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "description": "用户原始任务目标描述",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "任务当前状态",
      "enum": [
        "CREATED",
        "PLANNED",
        "RUNNING",
        "WAITING_BACKGROUND",
        "WAITING_EXTERNAL",
        "VERIFYING",
        "ITERATING",
        "BLOCKED_HIGH_RISK",
        "ESCALATED",
        "FAILED",
        "COMPLETED"
      ]
    },
    "owner": {
      "type": "object",
      "description": "任务发起者信息",
      "properties": {
        "sessionKey": {
          "type": "string",
          "description": "发起任务的 session 标识"
        },
        "channel": {
          "type": "string",
          "description": "消息渠道",
          "enum": ["discord", "slack", "cli", "web", "api"]
        },
        "chatId": {
          "type": "string",
          "description": "聊天/频道标识"
        },
        "requestMessageId": {
          "type": "string",
          "description": "请求消息ID"
        },
        "userMentionTag": {
          "type": "string",
          "description": "用户在渠道内的 @mention 标记（如 <@123456>）"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "任务创建时间 ISO8601"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "任务最后更新时间 ISO8601"
    },
    "lastProgressAt": {
      "type": "string",
      "format": "date-time",
      "description": "最后有进展的时间"
    },
    "nextWakeAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "下次唤醒检查时间，null 表示无需定向唤醒"
    },
    "currentIteration": {
      "type": "integer",
      "description": "当前迭代轮次",
      "minimum": 0,
      "default": 0
    },
    "maxIterations": {
      "type": "integer",
      "description": "最大允许迭代轮次",
      "minimum": 1,
      "default": 6
    },
    "completionCriteria": {
      "type": "array",
      "description": "完成标准列表",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "description": "标准项唯一ID"
          },
          "description": {
            "type": "string",
            "description": "标准描述"
          },
          "required": {
            "type": "boolean",
            "description": "是否为必须满足的标准",
            "default": true
          },
          "verified": {
            "type": "boolean",
            "description": "是否已验证通过",
            "default": false
          }
        }
      }
    },
    "riskPolicy": {
      "type": "object",
      "description": "风险策略配置",
      "properties": {
        "autoAllowed": {
          "type": "array",
          "description": "自动允许的工具/操作列表",
          "items": { "type": "string" }
        },
        "askOnce": {
          "type": "array",
          "description": "首次询问后续允许的操作列表",
          "items": { "type": "string" }
        },
        "mustConfirm": {
          "type": "array",
          "description": "每次必须确认的高风险操作列表",
          "items": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "子任务列表",
      "items": {
        "$ref": "./task.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "description": "产物文件列表",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": {
            "type": "string",
            "description": "产物相对路径"
          },
          "type": {
            "type": "string",
            "description": "产物类型",
            "enum": ["document", "code", "data", "image", "log", "summary"]
          },
          "description": {
            "type": "string",
            "description": "产物描述"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "生成时间"
          }
        }
      }
    },
    "backgroundProcesses": {
      "type": "array",
      "description": "后台进程跟踪列表",
      "items": {
        "type": "object",
        "required": ["processId", "taskId", "status"],
        "properties": {
          "processId": {
            "type": "string",
            "description": "进程/任务ID"
          },
          "taskId": {
            "type": "string",
            "description": "关联的子任务ID"
          },
          "status": {
            "type": "string",
            "enum": ["RUNNING", "COMPLETED", "FAILED", "TIMEOUT"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "outputPath": {
            "type": ["string", "null"],
            "description": "进程输出日志路径"
          }
        }
      }
    },
    "activeSessions": {
      "type": "array",
      "description": "当前活跃的执行会话",
      "items": {
        "type": "object",
        "properties": {
          "sessionKey": {
            "type": "string"
          },
          "agentType": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "验证状态",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "PASS", "RETRYABLE_GAP", "NONRETRYABLE_FAILURE", "NEEDS_HUMAN_DECISION"]
        },
        "lastCheckedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": {
          "type": ["string", "null"]
        },
        "criteriaResults": {
          "type": "array",
          "description": "各完成标准的验证结果",
          "items": {
            "type": "object",
            "required": ["criterionId", "passed"],
            "properties": {
              "criterionId": { "type": "string" },
              "passed": { "type": "boolean" },
              "reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "description": "升级信息",
      "properties": {
        "level": {
          "type": ["string", "null"],
          "enum": [null, "INFO", "WARNING", "CRITICAL"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "escalatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "flags": {
      "type": "object",
      "description": "状态标记 flags",
      "properties": {
        "notifiedStart": {
          "type": "boolean",
          "default": false
        },
        "notifiedComplete": {
          "type": "boolean",
          "default": false
        },
        "notifiedEscalation": {
          "type": "boolean",
          "default": false
        },
        "userUpdated": {
          "type": "boolean",
          "description": "用户是否补充了信息",
          "default": false
        },
        "notifiedTransitions": {
          "type": "object",
          "description": "幂等去重：key 如 'PLANNED->RUNNING' 或 'task:T1:READY->RUNNING'",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "扩展元数据",
      "additionalProperties": true
    }
  },
  "definitions": {}
}
