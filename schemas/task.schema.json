{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "title": "Task",
  "description": "Mission 子任务定义 Schema",
  "type": "object",
  "required": ["taskId", "title", "type", "status"],
  "properties": {
    "taskId": {
      "type": "string",
      "description": "子任务唯一标识符，格式：T{N} 或 task-{name}"
    },
    "title": {
      "type": "string",
      "description": "任务标题",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "任务详细描述"
    },
    "type": {
      "type": "string",
      "description": "任务类型",
      "enum": [
        "research",
        "analysis",
        "code",
        "document",
        "review",
        "test",
        "deploy",
        "verification",
        "notification",
        "external_wait"
      ]
    },
    "status": {
      "type": "string",
      "description": "任务状态",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "WAITING_BACKGROUND",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "SKIPPED"
      ]
    },
    "agent": {
      "type": ["string", "null"],
      "description": "负责执行的 agent 类型/名称"
    },
    "sessionKey": {
      "type": ["string", "null"],
      "description": "执行会话标识"
    },
    "dependsOn": {
      "type": "array",
      "description": "依赖的前置任务ID列表",
      "items": { "type": "string" },
      "default": []
    },
    "priority": {
      "type": "integer",
      "description": "优先级，数字越小优先级越高",
      "minimum": 0,
      "default": 10
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "endedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "estimatedDuration": {
      "type": ["integer", "null"],
      "description": "预计执行时长（秒）"
    },
    "timeout": {
      "type": ["integer", "null"],
      "description": "超时时间（秒）",
      "default": 300
    },
    "resultSummary": {
      "type": ["string", "null"],
      "description": "执行结果摘要"
    },
    "artifacts": {
      "type": "array",
      "description": "任务产生的产物",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "retryCount": {
      "type": "integer",
      "description": "已重试次数",
      "minimum": 0,
      "default": 0
    },
    "maxRetries": {
      "type": "integer",
      "description": "最大重试次数",
      "minimum": 0,
      "default": 2
    },
    "lastError": {
      "type": ["string", "null"],
      "description": "最后一次错误信息"
    },
    "backgroundProcessId": {
      "type": ["string", "null"],
      "description": "关联的后台进程ID"
    },
    "phase": {
      "type": "string",
      "description": "展示层分组标签，用于 dashboard 按阶段聚合展示。不影响执行逻辑。"
    },
    "fileBoundary": {
      "type": "array",
      "description": "该 task 允许修改的文件/目录范围。dispatch 时写入消息，帮助并行任务避免冲突。",
      "items": { "type": "string" }
    },
    "config": {
      "type": "object",
      "description": "任务特定配置",
      "additionalProperties": true
    }
  }
}
