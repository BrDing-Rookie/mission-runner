{
  "name": "@openclaw/mission-runner",
  "version": "0.1.0",
  "description": "OpenClaw 插件级自治任务编排层 - MVP Phase 1",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "build": "tsc",
    "mission-start": "tsx scripts/mission-start.ts",
    "mission-orchestrate": "tsx scripts/mission-orchestrate.ts",
    "mission-run-action": "tsx scripts/mission-run-action.ts",
    "mission-plan": "tsx scripts/mission-plan.ts",
    "mission-dispatch": "tsx scripts/mission-dispatch.ts",
    "mission-verify": "tsx scripts/mission-verify.ts",
    "mission-write-artifact": "tsx scripts/mission-write-artifact.ts",
    "mission-dashboard": "tsx scripts/mission-dashboard.ts",
    "mission-list": "tsx scripts/mission-list.ts",
    "task-update": "tsx scripts/task-update.ts",
    "task-add": "tsx scripts/task-add.ts",
    "watchdog": "tsx scripts/mission-watchdog.ts",
    "watchdog:dry-run": "tsx scripts/mission-watchdog.ts --dry-run",
    "watchdog:daemon": "tsx scripts/mission-watchdog.ts --daemon",
    "mission-orchestrate:auto": "tsx scripts/mission-orchestrate.ts --auto",
    "create-mission": "tsx scripts/mission-create.ts",
    "test:plugin-smoke": "node --import /home/ubuntu/public-deliverables/mission-runner/node_modules/tsx/dist/loader.mjs ./scripts/plugin-loader-smoke.ts"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
